# ==============================================================================
# Environment Configuration Template for HR & Payroll System
# Copy this file to .env before deploying: cp .env.example .env
# ==============================================================================

# Application Port (Host port mapped to container port 8080)
API_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (Host port mapped to container port 5432)
# Set DB_PORT to 5434, 5435, etc. if server already has PostgreSQL on 5432
DB_PORT=5434
DB_NAME=hr_payroll_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here

# Redis Configuration (Host port mapped to container port 6379)
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Security & JWT Configuration (Must be at least 256 bits / 32 characters in production)
JWT_SECRET=replace_with_a_super_secure_random_base64_key_min_32_bytes
JWT_EXPIRATION=86400000

# Bootstrap Admin Configuration (One-time initial administrator account)
BOOTSTRAP_ADMIN_USERNAME=your_admin_username_here
BOOTSTRAP_ADMIN_EMAIL=your_admin_email_here
BOOTSTRAP_ADMIN_PASSWORD=your_secure_bootstrap_admin_password_here
